# ML Kit instancia os ComponentRegistrar por reflexão (MlKitInitProvider).
# Sem estas regras o R8 remove os construtores e o reconhecimento de texto
# falha no build de release com NullPointerException.
-keep class * implements com.google.firebase.components.ComponentRegistrar { <init>(); }
-keep class com.google.mlkit.** { *; }
-keep class com.google.android.gms.internal.mlkit_vision_text_common.** { *; }
-keep class com.google_mlkit_** { *; }
